<Project>

  <PropertyGroup>
    <Version>0.9.1</Version>
    <!-- One English resource set, not two dozen satellite languages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Shieldsmith</Product>
    <Company>Cameron Shields</Company>
    <Authors>Cameron Shields</Authors>
    <Copyright>Copyright © Cameron Shields</Copyright>
  </PropertyGroup>

  <!--
    Release builds ship no debug symbols. A .pdb in a public download is dead
    weight and leaks the absolute paths of the machine that built it.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The build date, stamped into the assembly so the About screen can state
      when this copy was built rather than guess from a file timestamp, which
      changes whenever the file is copied. This does make each build differ
      from the last, which is the point: a user reporting a problem can say
      exactly which build they have.
    -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
