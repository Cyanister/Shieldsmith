<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Not "shieldsmith": the app publishes as Shieldsmith.exe and all three
      executables now share one folder so the .NET runtime is shipped once
      rather than three times. Windows file names are case-insensitive, so
      Shieldsmith.exe and shieldsmith.exe cannot coexist. The installer drops a
      shieldsmith.cmd shim beside this, so users still type "shieldsmith".
    -->
    <AssemblyName>shieldsmith-cli</AssemblyName>
    <RootNamespace>Shieldsmith.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shieldsmith.Ai\Shieldsmith.Ai.csproj" />
    <ProjectReference Include="..\Shieldsmith.ExportPack\Shieldsmith.ExportPack.csproj" />
    <ProjectReference Include="..\Shieldsmith.Mermaid\Shieldsmith.Mermaid.csproj" />
    <ProjectReference Include="..\Shieldsmith.Core\Shieldsmith.Core.csproj" />
    <ProjectReference Include="..\Shieldsmith.Outputs\Shieldsmith.Outputs.csproj" />
  </ItemGroup>

</Project>
