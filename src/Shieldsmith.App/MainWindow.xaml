<Window x:Class="Shieldsmith.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shieldsmith" Height="920" Width="1480" MinHeight="640" MinWidth="1100"
        Icon="Assets/shieldsmith.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- A stat tile: one number and its label, used in the summary strip. -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TintLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TintStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="92"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- The horizontal lockup already carries the wordmark, so
                         nothing here repeats the name in text. -->
                    <Image Source="Assets/shieldsmith-logo-horizontal.png" Height="40"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Width="1" Background="{StaticResource Border}" Margin="16,3,16,3"/>
                    <TextBlock Text="Power Platform solution documentation, offline"
                               FontSize="11.5" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" MaxWidth="280" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- What this machine can actually do, stated up front. -->
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="pillMermaid" Style="{StaticResource Pill}">
                        <TextBlock x:Name="txtPillMermaid" Style="{StaticResource PillText}" Text="Mermaid"/>
                    </Border>
                    <Border x:Name="pillGraphviz" Style="{StaticResource Pill}">
                        <TextBlock x:Name="txtPillGraphviz" Style="{StaticResource PillText}" Text="Graphviz"/>
                    </Border>
                    <Border x:Name="pillClaude" Style="{StaticResource Pill}">
                        <TextBlock x:Name="txtPillClaude" Style="{StaticResource PillText}" Text="Claude Code"/>
                    </Border>
                    <Button x:Name="btnAbout" Content="About" Style="{StaticResource GhostButton}"
                            Padding="12,4" Margin="6,0,0,6" Click="btnAbout_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1" Margin="22,18,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>

                    <!-- Solution -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Solution export" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="An unmanaged or managed .zip straight from Power Platform. Nothing is uploaded and no environment access is needed."
                                       Style="{StaticResource CardSubtitle}"/>

                            <Border x:Name="dropZone" CornerRadius="8" Padding="16"
                                    Background="{StaticResource TintLight}"
                                    BorderBrush="{StaticResource TintStrong}" BorderThickness="1.4"
                                    Cursor="Hand" MouseLeftButtonUp="dropZone_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtDropTitle" Text="Drop a solution .zip here"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDark}"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                    <TextBlock x:Name="txtDropHint" Text="or click to browse"
                                               FontSize="11" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="txtZipFilePath" Style="{StaticResource Field}"
                                     IsReadOnly="True" Margin="0,10,0,0" Visibility="Collapsed"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                            <Button x:Name="btnAnalyze" Content="Analyse solution"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                    Click="btnAnalyze_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagrams -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Diagrams" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Mermaid renders where WebView2 is present. It gives up quietly on very large diagrams, so Shieldsmith checks its output and falls back to the built-in engine, which has no dependencies and copes with any size."
                                       Style="{StaticResource CardSubtitle}"/>

                            <TextBlock Text="Engine" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbEngine" Style="{StaticResource Picker}">
                                <ComboBoxItem Content="Mermaid, falling back to built-in" IsSelected="True"/>
                                <ComboBoxItem Content="Built-in engine only"/>
                            </ComboBox>

                            <CheckBox x:Name="chkShowAttributes" Style="{StaticResource Check}"
                                      Content="Show columns on the ER diagram" IsChecked="True"
                                      Margin="0,12,0,0"/>
                            <CheckBox x:Name="chkFlowDiagrams" Style="{StaticResource Check}"
                                      Content="Draw a chart for each cloud flow" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- AI -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="AI interpretation" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Optional. Adds clearly labelled commentary to the Word and Markdown output. Off by default, and the document is complete without it."
                                       Style="{StaticResource CardSubtitle}"/>

                            <TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbAiProvider" Style="{StaticResource Picker}"
                                      SelectionChanged="cmbAiProvider_SelectionChanged">
                                <ComboBoxItem Content="None" IsSelected="True"/>
                                <ComboBoxItem Content="Claude (Anthropic API key)"/>
                                <ComboBoxItem Content="ChatGPT (OpenAI API key)"/>
                                <ComboBoxItem Content="Claude Code CLI (no key needed)"/>
                            </ComboBox>

                            <StackPanel x:Name="pnlApiKey" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock Text="API key" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="pwdApiKey" Grid.Column="0"
                                                 Style="{StaticResource SecretField}"/>
                                    <Button x:Name="btnSaveKey" Grid.Column="1" Content="Save"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0" Click="btnSaveKey_Click"/>
                                </Grid>
                                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                <TextBox x:Name="txtAiModel" Style="{StaticResource Field}"
                                         ToolTip="Model id; leave blank for the default"/>
                            </StackPanel>

                            <CheckBox x:Name="chkIncludeEnvValues" Style="{StaticResource Check}"
                                      Visibility="Collapsed" Margin="0,12,0,0" IsChecked="False"
                                      Content="Send environment variable values (off = redacted)"/>

                            <TextBlock x:Name="txtAiStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Outputs -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Outputs" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Available once a solution has been analysed."
                                       Style="{StaticResource CardSubtitle}"/>

                            <Button x:Name="btnGenerateWord" Content="Word document"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" IsEnabled="False"
                                    Click="btnGenerateWord_Click"/>
                            <Button x:Name="btnGenerateMarkdown" Content="Markdown set"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0" IsEnabled="False"
                                    Click="btnGenerateMarkdown_Click"/>
                            <Button x:Name="btnGenerateVisio" Content="Visio diagram"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0" IsEnabled="False"
                                    Click="btnGenerateVisio_Click"/>
                            <Button x:Name="btnExportPack" Content="Export for Claude Code"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0" IsEnabled="False"
                                    Click="btnExportPack_Click"
                                    ToolTip="Writes a docpack folder you can open in a Claude Code terminal to ask questions about the solution"/>
                            <Button x:Name="btnCopyMcp" Content="Copy MCP registration"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    Click="btnCopyMcp_Click"
                                    ToolTip="Copies a claude mcp add command that points at Shieldsmith's MCP server"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="cameronshields.co.uk" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="420">
                        <Image Source="Assets/shieldsmith-icon.png" Width="72" Height="72"
                               HorizontalAlignment="Center" Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Nothing analysed yet" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Drop a solution export anywhere on this window, or use the panel on the left. Shieldsmith reads the zip on this machine and sends nothing anywhere unless you turn AI on."
                                   Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Results -->
                    <Grid x:Name="resultsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Summary strip -->
                        <Border Grid.Row="0" Background="{StaticResource Surface}" Padding="18,16,18,14"
                                CornerRadius="10,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtSolutionName" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                    <Border x:Name="badgeManaged" Style="{StaticResource Pill}"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtBadgeManaged" Style="{StaticResource PillText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="txtSolutionMeta" Style="{StaticResource Hint}" Margin="0,3,0,0"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock x:Name="statTables" Style="{StaticResource StatNumber}"/>
                                            <TextBlock Text="Tables" Style="{StaticResource StatLabel}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock x:Name="statRelationships" Style="{StaticResource StatNumber}"/>
                                            <TextBlock Text="Relationships" Style="{StaticResource StatLabel}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock x:Name="statFlows" Style="{StaticResource StatNumber}"/>
                                            <TextBlock Text="Automations" Style="{StaticResource StatLabel}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock x:Name="statApps" Style="{StaticResource StatNumber}"/>
                                            <TextBlock Text="Apps" Style="{StaticResource StatLabel}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock x:Name="statAgents" Style="{StaticResource StatNumber}"/>
                                            <TextBlock Text="Agents" Style="{StaticResource StatLabel}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatTile}">
                                        <StackPanel>
                                            <TextBlock x:Name="statComponents" Style="{StaticResource StatNumber}"/>
                                            <TextBlock Text="Components" Style="{StaticResource StatLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TabControl Grid.Row="1" x:Name="tabResults" Style="{StaticResource Tabs}"
                                    Margin="18,0,18,16">

                            <TabItem Header="Tables">
                                <DataGrid x:Name="dgEntities" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="240"/>
                                        <DataGridTextColumn Header="Logical name" Binding="{Binding LogicalName}" Width="*"/>
                                        <DataGridTextColumn Header="Columns" Binding="{Binding Attributes.Count}" Width="90"/>
                                        <DataGridTextColumn Header="Ownership" Binding="{Binding OwnershipType}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Relationships">
                                <DataGrid x:Name="dgRelationships" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Relationship" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                                        <DataGridTextColumn Header="One" Binding="{Binding One}" Width="180"/>
                                        <DataGridTextColumn Header="Many" Binding="{Binding Many}" Width="180"/>
                                        <DataGridTextColumn Header="Via" Binding="{Binding Via}" Width="200"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Automations">
                                <DataGrid x:Name="dgProcesses" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="150"/>
                                        <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="*"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Apps">
                                <DataGrid x:Name="dgApps" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="180"/>
                                        <DataGridTextColumn Header="Contents" Binding="{Binding Detail}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Agents">
                                <DataGrid x:Name="dgAgents" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                                        <DataGridTextColumn Header="Topics" Binding="{Binding Topics}" Width="90"/>
                                        <DataGridTextColumn Header="Tools" Binding="{Binding Tools}" Width="90"/>
                                        <DataGridTextColumn Header="Knowledge" Binding="{Binding Knowledge}" Width="110"/>
                                        <DataGridTextColumn Header="Authentication" Binding="{Binding Auth}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Components">
                                <DataGrid x:Name="dgComponents" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="260"/>
                                        <DataGridTextColumn Header="Identifier" Binding="{Binding DisplayIdentifier}" Width="*"/>
                                        <DataGridTextColumn Header="Code" Binding="{Binding TypeCode}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Variables">
                                <DataGrid x:Name="dgEnvVars" Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding SchemaName}" Width="230"/>
                                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="110"/>
                                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="200"/>
                                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="200"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Diagrams">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbDiagram" Grid.Column="0"
                                                  Style="{StaticResource Picker}" MaxWidth="420"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="cmbDiagram_SelectionChanged"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="btnZoomOut" Content="&#x2013;" Width="36"
                                                    Style="{StaticResource GhostButton}" Padding="0,6"
                                                    Click="btnZoomOut_Click"/>
                                            <Button x:Name="btnZoomReset" Content="Fit width" Margin="6,0,0,0"
                                                    Style="{StaticResource GhostButton}" Padding="12,6"
                                                    Click="btnZoomReset_Click"/>
                                            <Button x:Name="btnZoomIn" Content="+" Width="36" Margin="6,0,0,0"
                                                    Style="{StaticResource GhostButton}" Padding="0,6"
                                                    Click="btnZoomIn_Click"/>
                                            <Button x:Name="btnCopyMermaid" Content="Copy Mermaid" Margin="12,0,0,0"
                                                    Style="{StaticResource GhostButton}"
                                                    Click="btnCopyMermaid_Click"
                                                    ToolTip="Copies the Mermaid source for the selected diagram"/>
                                            <Button x:Name="btnOpenDiagrams" Content="Open folder" Margin="6,0,0,0"
                                                    Style="{StaticResource GhostButton}"
                                                    Click="btnOpenDiagrams_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Background="{StaticResource Canvas}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="8" ClipToBounds="True">
                                        <Grid>
                                        <TextBlock x:Name="txtNoDiagram" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" MaxWidth="380"
                                                   Visibility="Collapsed"
                                                   Text="Nothing to draw. This solution has no tables and no cloud flows, so there is no diagram to show. The Notes tab says the same."/>
                                        <ScrollViewer x:Name="diagramScroller"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto" Padding="14">
                                            <Image x:Name="imgDiagram" Stretch="None"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform x:Name="diagramScale" ScaleX="1" ScaleY="1"/>
                                                </Image.LayoutTransform>
                                            </Image>
                                        </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Notes">
                                <DataGrid x:Name="dgDiagnostics" Style="{StaticResource DataGridStyle}"
                                          RowHeight="NaN">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="110"/>
                                        <DataGridTextColumn Header="Note" Binding="{Binding Message}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="Margin" Value="0,8"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar x:Name="progressBar" Style="{StaticResource Progress}"
                             IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="txtStatus" Margin="22,9" FontSize="12"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Ready."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
